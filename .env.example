# Android defaults to direct provider connections with secure on-device keys.
# Optional native backend mode: EXPO_PUBLIC_CONNECTION_MODE=backend
# Web/Windows still use the backend URL below.
EXPO_PUBLIC_API_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:8081
PORT=3001
# Production: a 64-hex-character encryption key, provided through your secret manager.
# SETTINGS_MASTER_KEY=
# Development on a physical phone over LAN HTTP only (keep false for production).
ALLOW_INSECURE_LOCAL_SETTINGS=false
# If deployed behind a trusted HTTPS reverse proxy, specify its address/subnet.
# TRUST_PROXY=127.0.0.1

# Container/persistent-host deployment
# HOST=0.0.0.0
# PRAMANA_DATA_DIR=/data/pramana
# TRUST_PROXY=1  # exact trusted edge-proxy hop count

# Optional Supabase accounts/profile sync (public client values only).
# Defaults point to Pramana's configured Free project.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
