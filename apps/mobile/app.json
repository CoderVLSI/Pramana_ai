{
  "expo": {
    "name": "Pramana",
    "slug": "pramana",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "org.pramana.study",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#202440"
      },
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Pramana · Scripture study",
      "favicon": "./assets/icon.png"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#202440"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Pramana to send live voice to your selected AI provider when you start voice.",
          "speechRecognitionPermission": "Allow Pramana to turn your spoken questions into text."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a screenshot to check a scripture quotation. Images are sent to your AI provider only when you tap Read screenshot.",
          "cameraPermission": false,
          "microphonePermission": "Allow Pramana to send live voice to your selected AI provider when you start voice."
        }
      ],
      "./plugins/with-live-audio"
    ]
  }
}
