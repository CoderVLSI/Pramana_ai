   "hierarchy": [
    {
     "name": "adhyaya",
     "value": "2"
    }
   ],
   "chapter": 4,
   "verse": "5",
   "original": "तदुक्तमृषिणा गर्भे नु सन्नन्वेषामवेदमहं देवानां जनिमानि विश्वा ॥ शतं मा पुर आयसीररक्षन्नधः श्येनो जवसा निरदीयमिति गर्भ एवैतच्छयानो वामदेव एवमुवाच",
   "source_locator": {
