  },
  {
   "hierarchy": [
    {
     "name": "adhyaya",
     "value": "3"
    }
   ],
   "chapter": 5,
   "verse": "2",
   "original": "यदेतत् हृदयं मनश्चैतत् ॥ संज्ञानमाज्ञानं विज्ञानं प्रज्ञानं मेधा दृष्टिर्धृतिर्मतिर्मनीषा जूतिः स्मृतिः संकल्पः क्रतुरसुः कामो वश इति ॥ सर्वाण्येवैतानि प्रज्ञानस्य नामधेयानि भवन्ति",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 60,
    "pdf_page": 75,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n74/mode/1up",
