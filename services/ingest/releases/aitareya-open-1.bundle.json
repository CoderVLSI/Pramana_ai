  {
   "hierarchy": [
    {
     "name": "adhyaya",
     "value": "2"
    }
   ],
   "chapter": 4,
   "verse": "1",
   "original": "पुरुषे ह वा अयमादितो गर्भो भवति । यदेतद्रेतस्तदेतत्सर्वेभ्योऽङ्गेभ्यस्तेजः संभूतमात्मन्येवात्मानं बिभर्ति तद्यदा स्त्रियां सिञ्चत्यथैनजनयति तदस्य प्रथमं जन्म",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 59,
    "pdf_page": 74,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n73/mode/1up",
