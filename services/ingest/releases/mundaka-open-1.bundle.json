   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 1,
   "verse": "6",
   "original": "तस्मादृचः साम यजूंषि दीक्षा यज्ञाश्च सर्वे क्रतवो दक्षिणाश्च ॥ संवत्सरं च यजमानश्च लोकाः सोमो यत्र पवते यत्र सूर्यः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 31,
    "pdf_page": 46,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n45/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 1,
   "verse": "7",
   "original": "तस्माच्च देवा बहुधा संप्रसूताः साध्या मनुष्याः पशवो वया५सि ॥ प्राणापानौ व्रीहियवौ तपश्च श्रद्धा सत्यं ब्रह्मचर्यं विधिश्च",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 31,
    "pdf_page": 46,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n45/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 1,
   "verse": "8",
   "original": "सप्त प्राणाः प्रभवन्ति तस्मात्सप्तार्चिषः समिधः सप्त होमाः ॥ सप्त इमे लोका येषु चरन्ति प्राणा गुहाशया निहिताः सप्त सप्त",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 31,
    "pdf_page": 46,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n45/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 1,
   "verse": "9",
   "original": "अतः समुद्रा गिरयश्च सर्वेऽस्मात्स्यन्दन्ते सिन्धवः सर्वरूपाः ॥ अतश्च सर्वा ओषधयो रसश्च येनैष भूतैस्तिष्ठते ह्यन्तरात्मा",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 31,
    "pdf_page": 46,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n45/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 1,
   "verse": "10",
   "original": "पुरुष एवेदं विश्वं कर्म तपो ब्रह्म परामृतम् ॥ एतद्यो वेद निहितं गुहायां सोऽविद्याग्रन्थिं विकिरतीह सोम्य",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 31,
    "pdf_page": 46,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n45/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "1",
   "original": "आविः संनिहितं गुहाचरं नाम महत्पदमत्रैतत्समर्पितम् ॥ एजत्प्राणन्निमिषच्च यदेतज्जानथ सदसद्वरेण्यं परं विज्ञानाद्यद्वरिष्ठं प्रजानाम्",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "2",
   "original": "यदर्चिमद्यदणुभ्योऽणु यस्मिँल्लोका निहिता लोकिनश्च ॥ तदेतदक्षरं ब्रह्म स प्राणस्तदु वाङ्मनः ॥ तदेतत्सत्यं तदमृतं तद्वेद्धव्यं सोम्य विद्धि",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "3",
   "original": "धनुर्गृहीत्वौपनिषदं महास्त्रं शरं ह्युपासानिशितं संधीयत ॥ आयम्य तद्भावगतेन चेतसा लक्ष्यं तदेवाक्षरं सोम्य विद्धि",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "4",
   "original": "प्रणवो धनुः शरो ह्यात्मा ब्रह्म तल्लक्ष्यमुच्यते ॥ अप्रमत्तेन वेद्धव्यं शरवत्तन्मयो भवेत्",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "5",
   "original": "यस्मिन्द्यौः पृथिवी चान्तरिक्षमोतं मनः सह प्राणैश्च सर्वैः ॥ तमेवैकं जानथ आत्मानमन्या वाचो विमुञ्चथामृतस्यैष सेतुः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "6",
   "original": "अरा इव रथनाभौ संहता यत्र नाड्यः ॥ स एषोऽन्तश्चरते बहुधा जायमानः ॥ ॐमित्येवं ध्यायथ आत्मानं स्वस्ति वः पाराय तमसः परस्तात्",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "7",
   "original": "यः सर्वज्ञः सर्वविद्यस्यैष महिमा भुवि ॥ दिव्ये ब्रह्मपुरे ह्येष व्योम्न्यात्मा प्रतिष्ठितः ॥ मनोमयः प्राणशरीरनेता प्रतिष्ठितोऽन्ने हृदयं संनिधाय ॥ तद्विज्ञानेन परिपश्यन्ति धीरा आनन्दरूपममृतं यद्विभाति",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "8",
   "original": "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः ॥ क्षीयन्ते चास्य कर्माणि तस्मिन्दृष्टे परावरे",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "9",
   "original": "हिरण्मये परे कोशे विरजं ब्रह्म निष्कलम् ॥ तच्छुभ्रं ज्योतिषां ज्योतिस्तद्यदात्मविदो विदुः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 32,
    "pdf_page": 47,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n46/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "10",
   "original": "न तत्र सूर्यो भाति न चन्द्रतारकं नेमा विद्युतो भान्ति कुतोऽयमग्निः ॥ तमेव भान्तमनुभाति सर्वं तस्य भासा सर्वमिदं विभाति",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "2"
    }
   ],
   "chapter": 2,
   "verse": "11",
   "original": "ब्रह्मैवेदममृतं पुरस्ताद्ब्रह्म पश्चाद्ब्रह्म दक्षिणतश्चोत्तरेण ॥ अधश्चोर्ध्वं च प्रसृतं ब्रह्मैवेदं विश्वमिदं वरिष्ठम्",
   "source_locator": {
