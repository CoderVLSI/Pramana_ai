  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "3",
   "original": "यदा पश्यः पश्यते रुक्मवर्णं कर्तारमीशं पुरुषं ब्रह्मयोनिम् ॥ तदा विद्वान्पुण्यपापे विधूय निरञ्जनः परमं साम्यमुपैति",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "4",
   "original": "प्राणो ह्येष यः सर्वभूतैर्विभाति विजानन्विद्वान्भवते नातिवादी ॥ आत्मक्रीड आत्मरतिः क्रियावानेष ब्रह्मविदां वरिष्ठः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "5",
   "original": "सत्येन लभ्यस्तपसा ह्येष आत्मा सम्यग्ज्ञानेन ब्रह्मचर्येण नित्यम् ॥ अन्तःशरीरे ज्योतिर्मयो हि शुभ्रो यं पश्यन्ति यतयः क्षीणदोषाः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "6",
   "original": "सत्यमेव जयते नानृतं सत्येन पन्था विततो देवयानः ॥ येनाक्रमन्त्यृषयो ह्याप्तकामा यत्र तत्सत्यस्य परमं निधानम्",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "7",
   "original": "बृहच्च तद्दिव्यमचिन्त्यरूपं सूक्ष्माच्च तत्सूक्ष्मतरं विभाति ॥ दूरात्सुदूरे तदिहान्तिके च पश्यत्स्विहैव निहितं गुहायाम्",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "8",
   "original": "न चक्षुषा गृह्यते नापि वाचा नान्यैर्देवैस्तपसा कर्मणा वा ॥ ज्ञानप्रसादेन विशुद्धसत्त्वस्ततस्तु तं पश्यते निष्कलं ध्यायमानः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 34,
    "pdf_page": 49,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n48/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "9",
   "original": "एषोऽणुरात्मा चेतसा वेदितव्यो यस्मिन्प्राणः पञ्चधा संविवेश ॥ प्राणैश्चित्तं सर्वमोतं प्रजानां यस्मिन्विशुद्धे विभवत्येष आत्मा",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 34,
    "pdf_page": 49,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n48/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "10",
   "original": "यं यं लोकं मनसा संविभाति विशुद्धसत्त्वः कामयते यांश्च कामान् ॥ तं तं लोकं जायते तांश्च कामांस्तस्मादात्मज्ञं ह्यर्चयेद्भूतिकामः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 34,
    "pdf_page": 49,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n48/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "1",
   "original": "स वेदैतत्परमं ब्रह्म धाम यत्र विश्वं निहितं भाति शुभ्रम् ॥ उपासते पुरुषं ये ह्यकामास्ते शुक्रमेतदतिवर्तन्ति धीराः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 34,
    "pdf_page": 49,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n48/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "2",
   "original": "कामान्यः कामयते मन्यमानः स कामभिर्जायते तत्र तत्र ॥ पर्याप्तकामस्य कृतात्मनस्तु इहैव सर्वे प्रविलीयन्ति कामाः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 34,
    "pdf_page": 49,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n48/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "3",
   "original": "नायमात्मा प्रवचनेन लभ्यो न मेधया न बहुना श्रुतेन ॥ यमेवैष वृणुते तेन लभ्यस्तस्यैष आत्मा विवृणुते तनुं स्वाम्",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 34,
    "pdf_page": 49,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n48/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "4",
   "original": "नायमात्मा बलहीनेन लभ्यो न च प्रमादात्तपसो वाप्यलिङ्गात् ॥ एतैरुपायैर्यतते यस्तु विद्वांस्तस्यैष आत्मा विशते ब्रह्मधाम",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 34,
    "pdf_page": 49,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n48/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "5",
   "original": "संप्राप्यैनमृषयो ज्ञानतृप्ताः कृतात्मानो वीतरागाः प्रशान्ताः ॥ ते सर्वगं सर्वतः प्राप्य धीरा युक्तात्मानः सर्वमेवाविशन्ति",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 34,
    "pdf_page": 49,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n48/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "6",
   "original": "वेदान्तविज्ञानसुनिश्चितार्थाः संन्यासयोगाद्यतयः शुद्धसत्त्वाः ॥ ते ब्रह्मलोकेषु परान्तकाले परामृताः परिमुच्यन्ति सर्वे",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 35,
    "pdf_page": 50,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n49/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "7",
   "original": "गताः कलाः पञ्चदश प्रतिष्ठा देवाश्च सर्वे प्रतिदेवतासु ॥ कर्माणि विज्ञानमयश्च आत्मा परेऽव्यये सर्व एकीभवन्ति",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 35,
    "pdf_page": 50,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n49/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "8",
   "original": "यथा नद्यः स्यन्दमानाः समुद्रेऽस्तं गच्छन्ति नामरूपे विहाय ॥ तथा विद्वान्नामरूपाद्विमुक्तः परात्परं पुरुषमुपैति दिव्यम्",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 35,
    "pdf_page": 50,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n49/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "9",
   "original": "स यो ह वै तत्परमं ब्रह्म वेद ब्रह्मैव भवति नास्याब्रह्मवित्कुले भवति तरति शोकं तरति पाप्मानं गुहाग्रन्थिभ्यो विमुक्तोऽमृतो भवति",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 35,
    "pdf_page": 50,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n49/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "10",
   "original": "तदेतदृचाऽभ्युक्तं । क्रियावन्तः श्रोत्रिया ब्रह्मनिष्ठाः स्वयं जुह्वत एकर्षिं श्रद्धयन्तः । तेषामेवैतां ब्रह्मविद्यां वदेत शिरोव्रतं विधिवद्यैस्तु चीर्णम्",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 35,
    "pdf_page": 50,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n49/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 2,
   "verse": "11",
   "original": "तदेतत्सत्यमृषिरङ्गिराः पुरोवाच नैतदचीर्णव्रतोऽधीते नमः परमऋषिभ्यो नमः परमऋषिभ्यः",
   "source_locator": {
