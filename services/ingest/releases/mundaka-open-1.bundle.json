    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "1",
   "original": "द्वा सुपर्णा सयुजा सखाया समानं वृक्षं परिषस्वजाते ॥ तयोरन्यः पिप्पलं स्वाद्वत्त्यनश्नन्नन्यो अभिचाकशीति",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
    "asset_sha256": "f71a2a102086055bced71e6570ccd97a628eb17972c8a42426da199ec298ed95"
   }
  },
  {
   "hierarchy": [
    {
     "name": "mundaka",
     "value": "3"
    }
   ],
   "chapter": 1,
   "verse": "2",
   "original": "समाने वृक्षे पुरुषो निमग्नोऽनीशया शोचति मुह्यमानः ॥ जुष्टं यदा पश्यत्यन्यमीशमस्य महिमानमिति वीतशोकः",
   "source_locator": {
    "volume": "scan:f71a2a102086",
    "printed_page": 33,
    "pdf_page": 48,
    "locator_kind": "scan",
    "source_url": "https://archive.org/details/twentyeightupan00upangoog/page/n47/mode/1up",
